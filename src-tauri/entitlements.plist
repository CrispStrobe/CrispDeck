<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for the Mac App Store. Everything below is the minimum this app
       actually needs; audited against the source rather than copied from a
       template, because unused entitlements invite review questions. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>

  <!-- Outbound: Bluesky/Mastodon APIs (tauri-plugin-http), avatar and media
       fetches, and the CrispASR model download in src-tauri/src/asr.rs. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- File pickers are used for settings/OPML import and media attachments.
       User-selected write access also permits saving exports through a panel. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Deliberately NOT requested:
       * network.server — native OAuth callbacks use the app URL scheme, not
         a loopback listener.
       * bookmarks.app-scope — access to selected files is not persisted.
       * temporary-exception.* — restricted entitlements that need review
         justification, and nothing here needs one. -->
</dict>
</plist>
