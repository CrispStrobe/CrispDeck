{
  "identifier": "mobile",
  "description": "Capabilities for mobile (iOS/Android)",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "http:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "notification:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
