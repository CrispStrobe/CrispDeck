{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrispDeck",
  "version": "1.3.4",
  "identifier": "com.christianstrobele.crispdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "CrispDeck",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https: http: wss: ws:",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob: https: http:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https: http: wss: ws:",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob: https: http:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["xdg-utils", "desktop-file-utils"]
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "category": "SocialNetworking"
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "app.vercel.crispdeck"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "app.vercel.crispdeck"
        ]
      }
    }
  }
}
